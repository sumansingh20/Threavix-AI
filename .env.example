# Environment Configuration Example

# Application Settings
APP_ENV=development
PROJECT_NAME="Threavix"
DESCRIPTION="Threavix — Agentic AI for Cyber Threat Intelligence & Incident Response"
VERSION=1.0.0
DEBUG=true

# API Settings
API_V1_STR=/api/v1

# CORS Settings
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000"

# Langfuse Settings
LANGFUSE_PUBLIC_KEY="your-langfuse-public-key"
LANGFUSE_SECRET_KEY="your-langfuse-secret-key"
LANGFUSE_HOST=https://cloud.langfuse.com

# LLM Settings
OPENAI_API_KEY="your-llm-api-key" # e.g. OpenAI API key
DEFAULT_LLM_MODEL=gpt-5-mini
DEFAULT_LLM_TEMPERATURE=0.2

# Threat Intelligence Settings (all optional)
# Threavix uses keyless public sources (ipwho.is, CIRCL CVE, MITRE ATT&CK, AlienVault OTX)
# by default. Add keys below to unlock premium enrichment providers.
VIRUSTOTAL_API_KEY=""
ABUSEIPDB_API_KEY=""
URLSCAN_API_KEY=""
THREAT_INTEL_TIMEOUT=15
THREAT_INTEL_USER_AGENT="Threavix/1.0 (Cyber Threat Intelligence Agent)"

# JWT Settings
JWT_SECRET_KEY="your-jwt-secret-key"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30

# Database Settings
POSTGRES_HOST=db
POSTGRES_DB=threavix
POSTGRES_USER=threavix
POSTGRES_PORT=5432
POSTGRES_PASSWORD=threavix
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10

# Rate Limiting Settings
RATE_LIMIT_DEFAULT="1000 per day,200 per hour"
RATE_LIMIT_CHAT="100 per minute"
RATE_LIMIT_CHAT_STREAM="100 per minute"
RATE_LIMIT_MESSAGES="200 per minute"
RATE_LIMIT_LOGIN="100 per minute"

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=console
